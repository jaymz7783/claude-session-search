# Copy to .env and adjust. docker compose reads .env automatically.

# Your Claude Code project folder: ~/.claude/projects/<working dir with / replaced by ->
# It holds the *.jsonl transcripts and the memory/ folder.
SESSION_DATA_DIR=/Users/you/.claude/projects/-Users-you-code

# Optional: the folder your repos live in. Lets cards show which repos a session worked in.
REPOS_ROOT=/Users/you/code
